## runtime image (Dockerfile)
2:FROM --platform=$BUILDPLATFORM registry-cn-hangzhou.ack.aliyuncs.com/dev/golang:1.26.6 AS builder
19:FROM registry.cn-hangzhou.aliyuncs.com/acs/alpine:3.18-update
